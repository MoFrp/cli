export PATH := $(PATH):`go env GOPATH`/bin
export GO111MODULE=on

VERSION ?= 0.68.1
COMMIT ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo "unknown")
BUILD_DATE ?= $(shell date -u +"%y%m%d")
LDFLAGS := -s -w -X github.com/fatedier/frp/pkg/util/version.version=$(VERSION) -X github.com/fatedier/frp/pkg/util/version.commit=$(COMMIT) -X github.com/fatedier/frp/pkg/util/version.buildDate=$(BUILD_DATE)

.PHONY: all build clean

all: build

build: darwin_amd64 darwin_arm64 freebsd_amd64 openbsd_amd64 linux_amd64 linux_arm_hf linux_arm linux_arm64 windows_amd64.exe windows_arm64.exe linux_mips64 linux_mips64le linux_mips linux_mipsle linux_riscv64 linux_loong64 android_arm64

darwin_amd64:
	@echo "Building frpc for darwin-amd64..."
	@mkdir -p release
	@env CGO_ENABLED=0 GOOS=darwin GOARCH=amd64 go build -trimpath -ldflags "$(LDFLAGS)" -tags "frpc,noweb" -o ./release/frpc_darwin_amd64 ./cmd/frpc
	@echo "Done: frpc_darwin_amd64"

